{
    "version": 2,
    "outputDirectory": "dist",
    "redirects": [
        {
            "source": "/aws",
            "destination": "/programmes/aws-restart",
            "permanent": false
        },
        {
            "source": "/restart",
            "destination": "/programmes/aws-restart",
            "permanent": false
        },
        {
            "source": "/postuler",
            "destination": "/programmes/aws-restart",
            "permanent": false
        }
    ],
    "rewrites": [
        {
            "source": "/",
            "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|TelegramBot|Slackbot|Discordbot|SkypeUriPreview|Pinterestbot).*" }],
            "destination": "/api"
        },
        {
            "source": "/programmes",
            "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|TelegramBot|Slackbot|Discordbot|SkypeUriPreview|Pinterestbot).*" }],
            "destination": "/api"
        },
        {
            "source": "/programmes/:slug",
            "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|TelegramBot|Slackbot|Discordbot|SkypeUriPreview|Pinterestbot).*" }],
            "destination": "/api"
        },
        {
            "source": "/(a-propos|rejoindre|formations|actualites|evenements|opportunites|elections|contact|plan-activites|sayc-membres-galerie)",
            "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|TelegramBot|Slackbot|Discordbot|SkypeUriPreview|Pinterestbot).*" }],
            "destination": "/api"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api"
        },
        {
            "source": "/opportunites/:id",
            "destination": "/api"
        },
        {
            "source": "/formations/:id",
            "destination": "/api"
        },
        {
            "source": "/evenements/:id",
            "destination": "/api"
        },
        {
            "source": "/actualites/:id",
            "destination": "/api"
        },
        {
            "source": "/((?!api/|locales/).*)",
            "destination": "/index.html"
        }
    ],
    "functions": {
        "api/index.js": {
            "maxDuration": 60
        }
    }
}